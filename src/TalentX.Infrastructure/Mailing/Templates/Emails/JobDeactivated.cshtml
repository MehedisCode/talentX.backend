@model TalentX.Infrastructure.Mailing.Models.JobDeactivatedEmailModel
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="light">
  <title>Job Deactivated — TalentX</title>
</head>
<body style="margin:0;padding:0;background:#f4f6f8;font-family:Arial,Helvetica,sans-serif;-webkit-font-smoothing:antialiased;">

  <div style="display:none;max-height:0;overflow:hidden;opacity:0;">
    Your job posting "@Model.JobTitle" has been deactivated by the TalentX admin team.
  </div>

  <div style="padding:24px 12px;">
    <div style="max-width:520px;margin:0 auto;background:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 1px 3px rgba(16,24,40,.10),0 1px 2px rgba(16,24,40,.06);">

      <div style="padding:26px 32px 0;">
        <span style="font-size:18px;font-weight:700;letter-spacing:-.2px;color:#059669;">Talent<span style="color:#111827;">X</span></span>
      </div>

      <div style="padding:22px 32px 0;">
        <span style="display:inline-block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.7px;color:#dc2626;background:#fef2f2;padding:5px 11px;border-radius:999px;">Job Deactivated</span>
        <h1 style="margin:14px 0 0;font-size:22px;line-height:1.3;color:#111827;font-weight:700;">Your job posting has been deactivated</h1>
      </div>

      <div style="padding:16px 32px 0;">
        <p style="margin:0;color:#4b5563;font-size:15px;line-height:1.6;">Hi @Model.RecipientName,</p>
        <p style="margin:12px 0 0;color:#4b5563;font-size:15px;line-height:1.6;">
          Your job posting <strong style="color:#111827;">@Model.JobTitle</strong> has been deactivated by the TalentX admin team and is no longer visible to candidates.
        </p>

        <div style="background:#fff5f5;border:1px solid #fecaca;border-radius:8px;padding:16px;margin:20px 0 0;">
        <p style="margin:0;color:#b91c1c;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;">
          Reason
        </p>
        <p style="margin:6px 0 0;color:#111827;font-size:15px;font-weight:700;">
          @Model.ReasonLabel
        </p>
        <p style="margin:12px 0 0;color:#4b5563;font-size:14px;line-height:1.6;white-space:pre-line;">
          @Model.Details
        </p>
        </div>

        <p style="margin:20px 0 0;color:#4b5563;font-size:15px;line-height:1.6;">
          You can edit the job to address this, then resubmit it for review. An admin will check it again before it goes back online.
        </p>

        <div style="text-align:center;margin:28px 0 6px;">
          <a href="@Model.EditJobUrl"
             style="display:inline-block;background:#059669;color:#ffffff;font-size:15px;font-weight:700;line-height:1;padding:14px 36px;border-radius:8px;text-decoration:none;">
            Edit job
          </a>
        </div>

        <p style="margin:18px 0 0;color:#6b7280;font-size:13px;line-height:1.5;">
          If the button above doesn't work, copy and paste this link into your browser:<br>
          <a href="@Model.EditJobUrl" style="color:#047857;word-break:break-all;">@Model.EditJobUrl</a>
        </p>
      </div>

      <div style="border-top:1px solid #eef0f3;margin-top:24px;padding:18px 32px 26px;">
        <p style="margin:0;color:#9ca3af;font-size:12px;line-height:1.5;">
          You're receiving this email because an administrator changed the status of your job posting on TalentX.
        </p>
        <p style="margin:10px 0 0;color:#b6bcc6;font-size:12px;">&copy; @DateTime.UtcNow.Year TalentX Inc. All rights reserved.</p>
      </div>

    </div>
  </div>
</body>
</html>
