@model TalentX.Infrastructure.Mailing.Models.VerificationLinkEmailModel
<!DOCTYPE html>
<html>
<head><meta charset="utf-8"><title>Verify Your Email — TalentX</title></head>
<body style="font-family:Arial,sans-serif;background:#f4f6f8;margin:0;padding:20px;">
  <div style="max-width:520px;margin:0 auto;background:#fff;border-radius:8px;padding:32px;box-shadow:0 2px 8px rgba(0,0,0,.05);">
    <h2 style="color:#111827;margin-top:0;">Verify Your Email</h2>
    <p style="color:#4b5563;font-size:15px;line-height:1.5;">
      Hello @Model.RecipientName,<br><br>
      Thank you for applying on TalentX. Please click the button below to verify your email and activate your application.
    </p>
    <div style="text-align:center;margin:28px 0;">
      <a href="@Model.VerificationUrl"
         style="display:inline-block;background:#059669;color:#fff;font-size:15px;font-weight:700;padding:12px 32px;border-radius:8px;text-decoration:none;">
        Verify My Email
      </a>
    </div>
    <p style="color:#6b7280;font-size:13px;">
      If the button doesn't work, copy and paste this link into your browser:<br>
      <a href="@Model.VerificationUrl" style="color:#059669;word-break:break-all;">@Model.VerificationUrl</a>
    </p>
    <p style="color:#9ca3af;font-size:12px;">This link expires in 30 minutes. If you didn't apply, you can safely ignore this email.</p>
    <hr style="border:none;border-top:1px solid #e5e7eb;margin:24px 0;">
    <p style="color:#9ca3af;font-size:12px;text-align:center;margin:0;">&copy; @DateTime.UtcNow.Year TalentX Inc.</p>
  </div>
</body>
</html>
