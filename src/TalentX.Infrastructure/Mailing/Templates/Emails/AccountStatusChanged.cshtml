@model TalentX.Infrastructure.Mailing.Models.AccountStatusChangedEmailModel
@{
  var isActive = Model.NewStatus == TalentX.Domain.Enums.AccountStatus.Active;
  var badgeText = isActive ? "Account Activated" : "Account Deactivated";
  var badgeColor = isActive ? "#059669" : "#dc2626";
  var badgeBackground = isActive ? "#ecfdf5" : "#fef2f2";
  var heading = isActive ? "Your account has been activated" : "Your account has been deactivated";
  var restrictedAction = Model.Role switch
  {
    TalentX.Domain.Enums.UserRole.Employer => "post new jobs",
    TalentX.Domain.Enums.UserRole.Talent => "apply to jobs",
    _ => "sign in",
  };
  var bodyText = isActive
    ? "Your TalentX account has been reactivated by an administrator. You can sign in and use the platform as usual."
    : $"Your TalentX account has been deactivated by an administrator. You will not be able to {restrictedAction} until it is reactivated.";
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="light">
  <title>@badgeText — TalentX</title>
</head>
<body style="margin:0;padding:0;background:#f4f6f8;font-family:Arial,Helvetica,sans-serif;-webkit-font-smoothing:antialiased;">

  <div style="display:none;max-height:0;overflow:hidden;opacity:0;">
    @bodyText
  </div>

  <div style="padding:24px 12px;">
    <div style="max-width:520px;margin:0 auto;background:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 1px 3px rgba(16,24,40,.10),0 1px 2px rgba(16,24,40,.06);">

      <div style="padding:26px 32px 0;">
        <span style="font-size:18px;font-weight:700;letter-spacing:-.2px;color:#059669;">Talent<span style="color:#111827;">X</span></span>
      </div>

      <div style="padding:22px 32px 0;">
        <span style="display:inline-block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.7px;color:@badgeColor;background:@badgeBackground;padding:5px 11px;border-radius:999px;">@badgeText</span>
        <h1 style="margin:14px 0 0;font-size:22px;line-height:1.3;color:#111827;font-weight:700;">@heading</h1>
      </div>

      <div style="padding:16px 32px 0;">
        <p style="margin:0;color:#4b5563;font-size:15px;line-height:1.6;">Hi @Model.RecipientName,</p>
        <p style="margin:12px 0 0;color:#4b5563;font-size:15px;line-height:1.6;">
          @bodyText
        </p>

        @if (!isActive)
        {
          <p style="margin:12px 0 0;color:#4b5563;font-size:15px;line-height:1.6;">
            If you believe this was a mistake, please contact TalentX support.
          </p>
        }

        <div style="text-align:center;margin:28px 0 6px;">
          <a href="https://talentx-stg-app.ait-us.co/dashboard"
             style="display:inline-block;background:#059669;color:#ffffff;font-size:15px;font-weight:700;line-height:1;padding:14px 36px;border-radius:8px;text-decoration:none;">
            Go to TalentX
          </a>
        </div>
      </div>

      <div style="border-top:1px solid #eef0f3;margin-top:24px;padding:18px 32px 26px;">
        <p style="margin:0;color:#9ca3af;font-size:12px;line-height:1.5;">
          You're receiving this email because an administrator changed your TalentX account status.
        </p>
        <p style="margin:10px 0 0;color:#b6bcc6;font-size:12px;">&copy; @DateTime.UtcNow.Year TalentX Inc. All rights reserved.</p>
      </div>

    </div>
  </div>
</body>
</html>
