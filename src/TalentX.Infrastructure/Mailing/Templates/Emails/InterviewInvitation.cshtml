@model TalentX.Infrastructure.Mailing.Models.InterviewInvitationEmailModel
<!DOCTYPE html>
<html>
<head><meta charset="utf-8"><title>New Interview Invitation</title></head>
<body style="font-family:Arial,sans-serif;background:#f4f6f8;margin:0;padding:20px;">
  <div style="max-width:520px;margin:0 auto;background:#fff;border-radius:8px;padding:32px;box-shadow:0 2px 8px rgba(0,0,0,.05);">
    <h2 style="color:#111827;margin-top:0;">New Interview Invitation</h2>
    <p style="color:#4b5563;font-size:15px;line-height:1.5;">
      Hi @Model.RecipientName,<br><br>
      You have received a new interview invitation for <strong>@Model.JobTitle</strong> at <strong>@Model.CompanyName</strong>.
    </p>
    <p style="color:#4b5563;font-size:15px;line-height:1.5;">
      Please log in to your <a href="https://talentx.com/dashboard" style="color:#2563eb;">TalentX Dashboard</a> to view the invitation details and accept or decline.
    </p>
    <hr style="border:none;border-top:1px solid #e5e7eb;margin:24px 0;">
    <p style="color:#9ca3af;font-size:12px;text-align:center;margin:0;">&copy; @DateTime.UtcNow.Year TalentX Inc.</p>
  </div>
</body>
</html>
