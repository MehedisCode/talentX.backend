@model TalentX.Infrastructure.Mailing.Models.InterviewInvitationEmailModel
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="light">
  <title>New Interview Invitation — TalentX</title>
</head>
<body style="margin:0;padding:0;background:#f4f6f8;font-family:Arial,Helvetica,sans-serif;-webkit-font-smoothing:antialiased;">

  <div style="display:none;max-height:0;overflow:hidden;opacity:0;">
    @Model.CompanyName invited you to interview for @Model.JobTitle. Review the details and respond on TalentX.
  </div>

  <div style="padding:24px 12px;">
    <div style="max-width:520px;margin:0 auto;background:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 1px 3px rgba(16,24,40,.10),0 1px 2px rgba(16,24,40,.06);">

      <div style="padding:26px 32px 0;">
        <span style="font-size:18px;font-weight:700;letter-spacing:-.2px;color:#059669;">Talent<span style="color:#111827;">X</span></span>
      </div>

      <div style="padding:22px 32px 0;">
        <span style="display:inline-block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.7px;color:#059669;background:#ecfdf5;padding:5px 11px;border-radius:999px;">Interview Invitation</span>
        <h1 style="margin:14px 0 0;font-size:22px;line-height:1.3;color:#111827;font-weight:700;">You've been invited to interview</h1>
      </div>

      <div style="padding:16px 32px 0;">
        <p style="margin:0;color:#4b5563;font-size:15px;line-height:1.6;">Hi @Model.RecipientName,</p>
        <p style="margin:12px 0 0;color:#4b5563;font-size:15px;line-height:1.6;">
          <strong style="color:#111827;">@Model.CompanyName</strong> has invited you to interview for the role below.
          Open your TalentX dashboard to review the details and accept or decline.
        </p>

        <div style="margin:24px 0 0;background:#f9fafb;border:1px solid #e5e7eb;border-radius:10px;padding:18px 20px;">
          <p style="margin:0;color:#6b7280;font-size:11px;text-transform:uppercase;letter-spacing:.6px;font-weight:700;">Position</p>
          <p style="margin:7px 0 0;color:#111827;font-size:17px;font-weight:700;line-height:1.35;">@Model.JobTitle</p>
          <p style="margin:4px 0 0;color:#4b5563;font-size:14px;">@Model.CompanyName</p>
        </div>

        <div style="text-align:center;margin:28px 0 6px;">
          <a href="https://talentx-stg-app.ait-us.co/interviews"
             style="display:inline-block;background:#059669;color:#ffffff;font-size:15px;font-weight:700;line-height:1;padding:14px 36px;border-radius:8px;text-decoration:none;">
            View &amp; Respond
          </a>
        </div>
        <p style="margin:0;text-align:center;color:#9ca3af;font-size:12px;line-height:1.5;">
          or go to your <a href="https://talentx-stg-app.ait-us.co/interviews" style="color:#059669;text-decoration:none;">interview dashboard</a>
        </p>
      </div>

      <div style="border-top:1px solid #eef0f3;margin-top:24px;padding:18px 32px 26px;">
        <p style="margin:0;color:#9ca3af;font-size:12px;line-height:1.5;">
          You're receiving this email because an employer sent you an interview invitation on TalentX.
        </p>
        <p style="margin:10px 0 0;color:#b6bcc6;font-size:12px;">&copy; @DateTime.UtcNow.Year TalentX Inc. All rights reserved.</p>
      </div>

    </div>
  </div>
</body>
</html>
