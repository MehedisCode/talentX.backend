@model TalentX.Infrastructure.Mailing.Models.AccountDeletedEmailModel
<!DOCTYPE html>
<html>
<head><meta charset="utf-8"><title>Account Deleted — TalentX</title></head>
<body style="font-family:Arial,sans-serif;background:#f4f6f8;margin:0;padding:20px;">
  <div style="max-width:520px;margin:0 auto;background:#fff;border-radius:8px;padding:32px;box-shadow:0 2px 8px rgba(0,0,0,.05);">
    <h2 style="color:#111827;margin-top:0;">Your Account Has Been Deleted</h2>
    <p style="color:#4b5563;font-size:15px;line-height:1.5;">
      Hello @Model.RecipientName,<br><br>
      Your TalentX account and all associated data have been permanently deleted as requested.
    </p>
    <p style="color:#4b5563;font-size:15px;line-height:1.5;">
      This action cannot be undone. If you ever wish to use TalentX again, you are welcome to sign up for a new account at any time.
    </p>
    <p style="color:#9ca3af;font-size:12px;">If you did not request this deletion, please contact our support team immediately.</p>
    <hr style="border:none;border-top:1px solid #e5e7eb;margin:24px 0;">
    <p style="color:#9ca3af;font-size:12px;text-align:center;margin:0;">&copy; @DateTime.UtcNow.Year TalentX Inc.</p>
  </div>
</body>
</html>
