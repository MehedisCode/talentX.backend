{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=talentx;Username=postgres;Password=your_password"
  },
  "Cors": {
    "FrontendUrl": "http://localhost:3000"
  },
  "Jwt": {
    "Issuer": "TalentX",
    "Audience": "TalentX.Client",
    "Secret": "your_strong_jwt_secret_min_32_characters",
    "AccessTokenMinutes": 15,
    "RefreshTokenExpiryDays": 7
  }
}
