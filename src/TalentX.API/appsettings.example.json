{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=talentx;Username=postgres;Password=your_password"
  },
  "Cors": {
    "FrontendUrl": "http://localhost:3000"
  },
  "Jwt": {
    "Issuer": "TalentX",
    "Audience": "TalentX.Client",
    "Secret": "your_strong_jwt_secret_min_32_characters",
    "AccessTokenMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "EmailSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "UserName": "your_email@domain.com",
    "Password": "your_smtp_app_password",
    "SenderEmail": "noreply@talentx.ai",
    "SenderName": "TalentX Support"
  },
  "FileStorage": {
    "Provider": "Local",
    "LocalBasePath": "App_Data/uploads",
    "S3": {
      "BucketName": "your_s3_bucket_name",
      "Region": "ap-southeast-1",
      "FolderPrefix": "resumes"
    }
  }
}
