# JWT Secret & Auth Settings
Jwt__Secret="your_strong_jwt_secret_min_32_characters"
JWT_ISSUER=TalentX
JWT_AUDIENCE=TalentX.Client

# Database Connection
ConnectionStrings__DefaultConnection="Host=localhost;Database=talentx;Username=postgres;Password=your_password"

# Google SMTP Email Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@asthait.com
SMTP_PASS=your_16_character_app_password
SENDER_EMAIL=your_email@asthait.com
SENDER_NAME=TalentX Support

# Google OAuth (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
