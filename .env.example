# ==============================================================================
# TalentX Backend Environment Configuration Template (.env.example)
# Copy this file to .env for Staging / Production / Local environment deployment.
# ==============================================================================

# Server Hosting & Networking
PORT=5000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENABLE_SWAGGER=true

# Database Connection (PostgreSQL)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=talentx;Username=postgres;Password=your_password

# Authentication (JWT)
Jwt__Secret=your_strong_jwt_secret_min_32_characters
Jwt__Issuer=TalentX
Jwt__Audience=TalentX.Client
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenExpiryDays=7

# Email Settings (SMTP)
EmailSettings__Host=smtp.gmail.com
EmailSettings__Port=587
EmailSettings__UserName=your_email@domain.com
EmailSettings__Password=your_smtp_app_password
EmailSettings__SenderEmail=noreply@talentx.ai
EmailSettings__SenderName=TalentX Support

# File Storage Configuration
FileStorage__Provider=Local
FileStorage__LocalBasePath=App_Data/uploads
FileStorage__S3__BucketName=your_s3_bucket_name
FileStorage__S3__Region=ap-southeast-1
FileStorage__S3__FolderPrefix=resumes

# ==============================================================================
# AI Talent Matching Configuration 
# ==============================================================================
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-3.7-flash
GEMINI_PROMPT_VERSION=v2
GEMINI_TEMPERATURE=0
GEMINI_TOP_P=1.0
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_SEED=42
GEMINI_MATCH_BATCH_SIZE=50

# ==============================================================================
# Presigned URL Configuration
# ==============================================================================
PRESIGNED_URL_EXPIRY_MINUTES=15



# ==============================================================================
# Admin Seed Credentials
# ==============================================================================
ADMIN_EMAIL=superadmin@ait.com
ADMIN_PASS=SuperAdmin@123

