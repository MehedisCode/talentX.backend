# TalentX Backend Environment Configuration Template
PORT=5035

ASPNETCORE_ENVIRONMENT=Production

ENABLE_SWAGGER=true

CORS_ALLOWED_ORIGINS="http://localhost:3000,https://talentx.ai,https://app.talentx.ai"

DB_HOST=localhost
DB_PORT=5432
DB_NAME=talentx
DB_USER_NAME=postgres
DB_PASSWORD=your_strong_password

JWT_SECRET=your_production_jwt_secret_min_32_characters_long_super_secure
JWT_ISSUER=TalentX
JWT_AUDIENCE=TalentX.Client

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@asthait.com
SMTP_PASS=your_16_character_app_password
SENDER_EMAIL=your_email@asthait.com
SENDER_NAME=TalentX Support

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-southeast-1

# File Storage Configuration
FILE_STORAGE_PROVIDER=S3
FILE_STORAGE_LOCAL_BASE_PATH=uploads
FILE_STORAGE_S3_BUCKET_NAME=talentx-s3-staging
FILE_STORAGE_S3_REGION=ap-southeast-1
FILE_STORAGE_S3_FOLDER_PREFIX=resumes

